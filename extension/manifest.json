{
  "manifest_version": 3,
  "name": "AI Browser Assistant",
  "version": "1.0",
  "description": "Extension for local AI assistant to control the web browser",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "ws://localhost:8000/*",
    "<all_urls>"
  ],
  "background": {
    "type": "module",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-assistant@local.ai"
    }
  }
}
